{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: ['config:recommended'],
	timezone: 'Europe/Berlin',
	// no lockFileMaintenance: a refresh of all locks has no release timestamp, so it would never pass this age
	// check, and without it fresh transitive releases would land unchecked; direct updates still refresh the lock
	minimumReleaseAge: '3 days',
	// Renovate merges itself once CI is green, as in our other GitHub repositories
	platformAutomerge: false,
	// security fixes must not wait out the release age, and go straight to the newest version: the lowest fixed one
	// may not build against the rest of the lockfile
	vulnerabilityAlerts: {
		minimumReleaseAge: null,
		vulnerabilityFixStrategy: 'highest'
	},
	packageRules: [
		{
			matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
			automerge: true
		},
		{
			// a minor bump below 1.0 may break
			matchUpdateTypes: ['minor'],
			matchCurrentVersion: '/^0\\./',
			automerge: false
		}
	]
}
